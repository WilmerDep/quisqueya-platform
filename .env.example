NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
VITE_API_URL=http://localhost:3000/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=quisqueya_user
