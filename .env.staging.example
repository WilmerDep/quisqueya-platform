NODE_ENV=production
APP_ENV=staging
PORT=3000

# Provisional PholioDev environment. CRM/CMS and API share the same host.
# NODE_ENV remains production so Node/Vite/Nest use optimized runtime behavior;
# APP_ENV is the project-level environment flag that distinguishes staging from real production.
APP_URL=https://crmquisqueya.pholiodev.com
VITE_API_URL=/api/v1
CORS_ORIGINS=https://quisqueya.pholiodev.com,https://crmquisqueya.pholiodev.com

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=quisqueya_user
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_DATABASE=quisqueya_core
MYSQL_POOL_LIMIT=10
DATABASE_URL="mysql://quisqueya_user:replace-with-a-strong-database-password@127.0.0.1:3306/quisqueya_core"

JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Media storage
STORAGE_PROVIDER=google-drive
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DRIVE_REDIRECT_URI=https://crmquisqueya.pholiodev.com/api/v1/integrations/google-drive/callback
