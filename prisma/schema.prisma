generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  relationMode = "prisma"
}

enum CompanyStatus {
  ACTIVE
  RESTRICTED
  SUSPENDED
  TRIAL
  CANCELLED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum UserRole {
  SUPER_ADMIN   @map("Super Admin")
  ADMINISTRADOR @map("Administrador")
  SUPERVISOR    @map("Supervisor")
  COBRADOR      @map("Cobrador")
}

enum ClientCreditRating {
  BUENA
  REGULAR
  MALA
}

enum ClientStatus {
  PENDIENTE @map("Pendiente")
  APROBADO  @map("Aprobado")
  RECHAZADO @map("Rechazado")
}

enum LoanFrequency {
  DIARIO     @map("Diario")
  SEMANAL    @map("Semanal")
  QUINCENAL  @map("Quincenal")
  MENSUAL    @map("Mensual")
}

enum LoanStatus {
  ACTIVO    @map("Activo")
  SALDADO   @map("Saldado")
  EN_MORA   @map("En Mora")
  CANCELADO @map("Cancelado")
}

enum InstallmentStatus {
  PENDIENTE
  PAGADO
  PARCIAL
  VENCIDO
}

enum RouteStatus {
  ABIERTA  @map("Abierta")
  EN_CURSO @map("En Curso")
  CERRADA  @map("Cerrada")
}

enum RouteItemVisitStatus {
  PENDING
  VISITED
  PAID
  PROMISED
  FAILED
}

enum CashMovementType {
  IN
  OUT
}

enum SyncQueueStatus {
  PENDING
  APPLIED
  REJECTED
}

model Plan {
  id           String    @id @db.VarChar(64)
  name         String    @db.VarChar(120)
  monthlyPrice Decimal   @default(0) @map("monthly_price") @db.Decimal(12, 2)
  yearlyPrice  Decimal   @default(0) @map("yearly_price") @db.Decimal(12, 2)
  maxUsers     Int       @default(1) @map("max_users")
  maxBranches  Int       @default(1) @map("max_branches")
  maxClients   Int       @default(50) @map("max_clients")
  featuresJson Json?     @map("features_json")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  companies    Company[]

  @@map("plans")
}

model Company {
  id                String        @id @db.VarChar(64)
  name              String        @db.VarChar(180)
  rnc               String?       @db.VarChar(32)
  logo              String?       @db.Text
  status            CompanyStatus @default(ACTIVE)
  planId            String        @map("plan_id") @db.VarChar(64)
  billingCycle      BillingCycle  @default(MONTHLY) @map("billing_cycle")
  expiresAt         DateTime?     @map("expires_at") @db.Date
  billingDay        Int           @default(1) @map("billing_day")
  subscriptionPrice Decimal       @default(0) @map("subscription_price") @db.Decimal(12, 2)
  configJson        Json?         @map("config_json")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamp(0)
  plan              Plan          @relation(fields: [planId], references: [id])
  branches          Branch[]
  users             User[]
  clients           Client[]
  loans             Loan[]
  payments          Payment[]
  routes            CollectionRoute[]
  cashMovements     CashMovement[]
  cashClosures      CashClosure[]
  reportExports     ReportExport[]
  reportSchedules   ReportSchedule[]
  reportTemplates   ReportTemplate[]
  auditLogs         AuditLog[]
  syncQueue         SyncQueue[]

  @@index([planId], map: "idx_companies_plan")
  @@map("companies")
}

model Branch {
  id           String         @id @db.VarChar(64)
  companyId    String         @map("company_id") @db.VarChar(64)
  name         String         @db.VarChar(160)
  address      String         @db.Text
  phone        String?        @db.VarChar(32)
  logo         String?        @db.Text
  managerName  String?        @map("manager_name") @db.VarChar(160)
  monthlyGoal  Decimal        @default(0) @map("monthly_goal") @db.Decimal(12, 2)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamp(0)
  company      Company        @relation(fields: [companyId], references: [id])
  users        User[]
  clients      Client[]
  loans        Loan[]
  payments     Payment[]
  routes       CollectionRoute[]
  cashMovements CashMovement[]
  cashClosures CashClosure[]
  reportExports ReportExport[]
  reportSchedules ReportSchedule[]

  @@index([companyId], map: "idx_branches_company")
  @@map("branches")
}

model User {
  id            String         @id @db.VarChar(64)
  companyId     String         @map("company_id") @db.VarChar(64)
  branchId      String         @map("branch_id") @db.VarChar(64)
  name          String         @db.VarChar(180)
  username      String         @unique @db.VarChar(80)
  email         String?        @db.VarChar(180)
  passwordHash  String         @map("password_hash") @db.VarChar(255)
  role          UserRole
  avatar        String?        @db.VarChar(12)
  photo         String?        @db.Text
  isActive      Boolean        @default(true) @map("is_active")
  phone         String?        @db.VarChar(32)
  permissionsJson Json?        @map("permissions_json")
  lastLoginAt   DateTime?      @map("last_login_at") @db.Timestamp(0)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamp(0)
  company       Company        @relation(fields: [companyId], references: [id])
  branch        Branch         @relation(fields: [branchId], references: [id])
  assignedClients Client[]     @relation("ClientAssignedUser")
  payments      Payment[]
  routes        CollectionRoute[]
  visitLogs     VisitLog[]
  cashMovements CashMovement[]
  cashClosures  CashClosure[]
  reportExports ReportExport[]
  reportSchedules ReportSchedule[]
  reportTemplates ReportTemplate[]
  auditLogs     AuditLog[]
  syncQueue     SyncQueue[]

  @@index([companyId, branchId], map: "idx_users_company_branch")
  @@index([companyId], map: "idx_users_company")
  @@index([branchId], map: "idx_users_branch")
  @@map("users")
}

model Client {
  id             String              @id @db.VarChar(64)
  companyId      String              @map("company_id") @db.VarChar(64)
  branchId       String              @map("branch_id") @db.VarChar(64)
  firstName      String              @map("first_name") @db.VarChar(120)
  lastName       String              @map("last_name") @db.VarChar(120)
  nickname       String?             @db.VarChar(120)
  cedula         String              @db.VarChar(32)
  phone          String              @db.VarChar(32)
  address        String              @db.Text
  assignedUserId String              @map("assigned_user_id") @db.VarChar(64)
  creditRating   ClientCreditRating? @default(BUENA) @map("credit_rating")
  isBlocked      Boolean             @default(false) @map("is_blocked")
  status         ClientStatus        @default(PENDIENTE)
  photo          String?             @db.Text
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamp(0)
  company        Company             @relation(fields: [companyId], references: [id])
  branch         Branch              @relation(fields: [branchId], references: [id])
  assignedUser   User                @relation("ClientAssignedUser", fields: [assignedUserId], references: [id])
  loans          Loan[]
  routeItems     RouteItem[]
  visitLogs      VisitLog[]
  paymentPromises PaymentPromise[]

  @@unique([companyId, cedula], map: "uniq_client_company_cedula")
  @@index([companyId, branchId], map: "idx_clients_company_branch")
  @@index([companyId], map: "idx_clients_company")
  @@index([assignedUserId], map: "idx_clients_assigned_user")
  @@index([branchId], map: "idx_clients_branch")
  @@map("clients")
}

model Loan {
  id            String        @id @db.VarChar(64)
  companyId     String        @map("company_id") @db.VarChar(64)
  branchId      String        @map("branch_id") @db.VarChar(64)
  clientId      String        @map("client_id") @db.VarChar(64)
  amount        Decimal       @db.Decimal(12, 2)
  interestRate  Decimal       @default(0) @map("interest_rate") @db.Decimal(8, 2)
  frequency     LoanFrequency
  duration      Int
  startDate     DateTime      @map("start_date") @db.Date
  totalToPay    Decimal       @map("total_to_pay") @db.Decimal(12, 2)
  balance       Decimal       @db.Decimal(12, 2)
  status        LoanStatus    @default(ACTIVO)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamp(0)
  company       Company       @relation(fields: [companyId], references: [id])
  branch        Branch        @relation(fields: [branchId], references: [id])
  client        Client        @relation(fields: [clientId], references: [id])
  installments  Installment[]
  payments      Payment[]
  routeItems    RouteItem[]
  paymentPromises PaymentPromise[]

  @@index([companyId, branchId], map: "idx_loans_company_branch")
  @@index([companyId], map: "idx_loans_company")
  @@index([clientId], map: "idx_loans_client")
  @@index([branchId], map: "idx_loans_branch")
  @@map("loans")
}

model Installment {
  id             String            @id @db.VarChar(64)
  loanId         String            @map("loan_id") @db.VarChar(64)
  number         Int
  dueDate        DateTime          @map("due_date") @db.Date
  expectedAmount Decimal           @map("expected_amount") @db.Decimal(12, 2)
  paidAmount     Decimal           @default(0) @map("paid_amount") @db.Decimal(12, 2)
  status         InstallmentStatus @default(PENDIENTE)
  paidAt         DateTime?         @map("paid_at") @db.Timestamp(0)
  loan           Loan              @relation(fields: [loanId], references: [id])
  payments       Payment[]
  routeItems     RouteItem[]

  @@index([loanId, dueDate], map: "idx_installments_loan_due")
  @@index([loanId], map: "idx_installments_loan")
  @@map("installments")
}

model Payment {
  id            String       @id @db.VarChar(64)
  companyId     String       @map("company_id") @db.VarChar(64)
  branchId      String       @map("branch_id") @db.VarChar(64)
  loanId        String       @map("loan_id") @db.VarChar(64)
  installmentId String       @map("installment_id") @db.VarChar(64)
  userId        String       @map("user_id") @db.VarChar(64)
  amount        Decimal      @db.Decimal(12, 2)
  moraPaid      Decimal      @default(0) @map("mora_paid") @db.Decimal(12, 2)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamp(0)
  company       Company      @relation(fields: [companyId], references: [id])
  branch        Branch       @relation(fields: [branchId], references: [id])
  loan          Loan         @relation(fields: [loanId], references: [id])
  installment   Installment  @relation(fields: [installmentId], references: [id])
  user          User         @relation(fields: [userId], references: [id])
  void          PaymentVoid?

  @@index([companyId, createdAt], map: "idx_payments_company_created")
  @@index([companyId], map: "idx_payments_company")
  @@index([branchId], map: "idx_payments_branch")
  @@index([loanId], map: "idx_payments_loan")
  @@index([installmentId], map: "idx_payments_installment")
  @@index([userId], map: "idx_payments_user")
  @@map("payments")
}

model PaymentVoid {
  id          String   @id @db.VarChar(64)
  paymentId   String   @unique(map: "uniq_void_payment") @map("payment_id") @db.VarChar(64)
  companyId   String   @map("company_id") @db.VarChar(64)
  actorUserId String   @map("actor_user_id") @db.VarChar(64)
  reason      String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  payment     Payment  @relation(fields: [paymentId], references: [id])

  @@index([companyId], map: "idx_payment_voids_company")
  @@map("payment_voids")
}

model CollectionRoute {
  id          String      @id @db.VarChar(64)
  companyId   String      @map("company_id") @db.VarChar(64)
  branchId    String      @map("branch_id") @db.VarChar(64)
  collectorId String      @map("collector_id") @db.VarChar(64)
  date        DateTime    @db.Date
  status      RouteStatus @default(ABIERTA)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamp(0)
  company     Company     @relation(fields: [companyId], references: [id])
  branch      Branch      @relation(fields: [branchId], references: [id])
  collector   User        @relation(fields: [collectorId], references: [id])
  items       RouteItem[]

  @@index([companyId, branchId, date], map: "idx_routes_company_branch_date")
  @@index([companyId], map: "idx_routes_company")
  @@index([branchId], map: "idx_routes_branch")
  @@index([collectorId], map: "idx_routes_collector")
  @@map("collection_routes")
}

model RouteItem {
  id              String               @id @db.VarChar(64)
  routeId         String               @map("route_id") @db.VarChar(64)
  loanId          String               @map("loan_id") @db.VarChar(64)
  installmentId   String?              @map("installment_id") @db.VarChar(64)
  clientId        String               @map("client_id") @db.VarChar(64)
  clientName      String               @map("client_name") @db.VarChar(240)
  address         String               @db.Text
  amountToCollect Decimal              @map("amount_to_collect") @db.Decimal(12, 2)
  sortOrder       Int                  @map("sort_order")
  visitStatus     RouteItemVisitStatus @default(PENDING) @map("visit_status")
  visitResult     String?              @map("visit_result") @db.VarChar(40)
  notes           String?              @db.Text
  route           CollectionRoute      @relation(fields: [routeId], references: [id])
  loan            Loan                 @relation(fields: [loanId], references: [id])
  installment     Installment?         @relation(fields: [installmentId], references: [id])
  client          Client               @relation(fields: [clientId], references: [id])

  @@index([routeId], map: "idx_route_items_route")
  @@index([loanId], map: "idx_route_items_loan")
  @@index([installmentId], map: "idx_route_items_installment")
  @@index([clientId], map: "idx_route_items_client")
  @@map("route_items")
}

model VisitLog {
  id        String   @id @db.VarChar(64)
  companyId String   @map("company_id") @db.VarChar(64)
  clientId  String   @map("client_id") @db.VarChar(64)
  userId    String   @map("user_id") @db.VarChar(64)
  result    String   @db.VarChar(80)
  note      String?  @db.Text
  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  client    Client   @relation(fields: [clientId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([companyId, clientId], map: "idx_visit_logs_company_client")
  @@index([clientId], map: "idx_visit_logs_client")
  @@index([userId], map: "idx_visit_logs_user")
  @@map("visit_logs")
}

model PaymentPromise {
  id        String   @id @db.VarChar(64)
  companyId String   @map("company_id") @db.VarChar(64)
  clientId  String   @map("client_id") @db.VarChar(64)
  loanId    String   @map("loan_id") @db.VarChar(64)
  date      DateTime @db.Date
  amount    Decimal  @db.Decimal(12, 2)
  status    String   @default("PENDIENTE") @db.VarChar(40)
  note      String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  client    Client   @relation(fields: [clientId], references: [id])
  loan      Loan     @relation(fields: [loanId], references: [id])

  @@index([companyId, clientId], map: "idx_payment_promises_company_client")
  @@index([clientId], map: "idx_payment_promises_client")
  @@index([loanId], map: "idx_payment_promises_loan")
  @@map("payment_promises")
}

model CashMovement {
  id        String           @id @db.VarChar(64)
  companyId String           @map("company_id") @db.VarChar(64)
  branchId  String           @map("branch_id") @db.VarChar(64)
  userId    String           @map("user_id") @db.VarChar(64)
  type      CashMovementType
  category  String           @db.VarChar(40)
  amount    Decimal          @db.Decimal(12, 2)
  note      String           @db.Text
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamp(0)
  company   Company          @relation(fields: [companyId], references: [id])
  branch    Branch           @relation(fields: [branchId], references: [id])
  user      User             @relation(fields: [userId], references: [id])

  @@index([companyId, branchId, createdAt], map: "idx_cash_company_branch_created")
  @@index([companyId], map: "idx_cash_company")
  @@index([branchId], map: "idx_cash_branch")
  @@index([userId], map: "idx_cash_user")
  @@map("cash_movements")
}

model CashClosure {
  id               String   @id @db.VarChar(64)
  companyId        String   @map("company_id") @db.VarChar(64)
  branchId         String   @map("branch_id") @db.VarChar(64)
  userId           String   @map("user_id") @db.VarChar(64)
  businessDate     DateTime @map("business_date") @db.Date
  theoreticalAmount Decimal @map("theoretical_amount") @db.Decimal(12, 2)
  countedAmount    Decimal  @map("counted_amount") @db.Decimal(12, 2)
  differenceAmount Decimal  @map("difference_amount") @db.Decimal(12, 2)
  status           String   @db.VarChar(40)
  note             String?  @db.Text
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  company          Company  @relation(fields: [companyId], references: [id])
  branch           Branch   @relation(fields: [branchId], references: [id])
  user             User     @relation(fields: [userId], references: [id])

  @@unique([companyId, branchId, businessDate], map: "uniq_cash_closure_company_branch_date")
  @@index([companyId, branchId, createdAt], map: "idx_cash_closure_company_branch_created")
  @@index([userId], map: "idx_cash_closure_user")
  @@map("cash_closures")
}

model ReportExport {
  id            String    @id @db.VarChar(64)
  companyId     String    @map("company_id") @db.VarChar(64)
  branchId      String?   @map("branch_id") @db.VarChar(64)
  userId        String    @map("user_id") @db.VarChar(64)
  reportName    String    @map("report_name") @db.VarChar(180)
  reportType    String    @map("report_type") @db.VarChar(40)
  format        String    @db.VarChar(16)
  rangeLabel    String    @map("range_label") @db.VarChar(120)
  startDate     DateTime? @map("start_date") @db.Date
  endDate       DateTime? @map("end_date") @db.Date
  branchName    String?   @map("branch_name") @db.VarChar(160)
  collectorId   String?   @map("collector_id") @db.VarChar(64)
  collectorName String?   @map("collector_name") @db.VarChar(180)
  fileSizeLabel String?   @map("file_size_label") @db.VarChar(40)
  filtersJson   Json?     @map("filters_json")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  company       Company   @relation(fields: [companyId], references: [id])
  branch        Branch?   @relation(fields: [branchId], references: [id])
  user          User      @relation(fields: [userId], references: [id])

  @@index([companyId, createdAt], map: "idx_report_exports_company_created")
  @@index([companyId], map: "idx_report_exports_company")
  @@index([branchId], map: "idx_report_exports_branch")
  @@index([userId], map: "idx_report_exports_user")
  @@map("report_exports")
}

model ReportSchedule {
  id           String   @id @db.VarChar(64)
  companyId    String   @map("company_id") @db.VarChar(64)
  branchId     String?  @map("branch_id") @db.VarChar(64)
  userId       String   @map("user_id") @db.VarChar(64)
  name         String   @db.VarChar(180)
  reportType   String   @map("report_type") @db.VarChar(40)
  format       String   @db.VarChar(16)
  frequency    String   @db.VarChar(24)
  deliveryHour String   @map("delivery_hour") @db.VarChar(16)
  targetLabel  String   @map("target_label") @db.VarChar(180)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  company      Company  @relation(fields: [companyId], references: [id])
  branch       Branch?  @relation(fields: [branchId], references: [id])
  user         User     @relation(fields: [userId], references: [id])

  @@index([companyId, createdAt], map: "idx_report_schedules_company_created")
  @@index([branchId], map: "idx_report_schedules_branch")
  @@index([userId], map: "idx_report_schedules_user")
  @@map("report_schedules")
}

model ReportTemplate {
  id           String   @id @db.VarChar(64)
  companyId    String   @map("company_id") @db.VarChar(64)
  userId       String   @map("user_id") @db.VarChar(64)
  name         String   @db.VarChar(180)
  reportType   String   @map("report_type") @db.VarChar(40)
  status       String   @db.VarChar(24)
  isDefault    Boolean  @default(false) @map("is_default")
  sectionsJson Json?    @map("sections_json")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  company      Company  @relation(fields: [companyId], references: [id])
  user         User     @relation(fields: [userId], references: [id])

  @@index([companyId, createdAt], map: "idx_report_templates_company_created")
  @@index([userId], map: "idx_report_templates_user")
  @@map("report_templates")
}

model AuditLog {
  id          String   @id @db.VarChar(64)
  companyId   String   @map("company_id") @db.VarChar(64)
  branchId    String?  @map("branch_id") @db.VarChar(64)
  actorUserId String?  @map("actor_user_id") @db.VarChar(64)
  action      String   @db.VarChar(120)
  entityType  String   @map("entity_type") @db.VarChar(80)
  entityId    String?  @map("entity_id") @db.VarChar(64)
  metadataJson Json?   @map("metadata_json")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  company     Company  @relation(fields: [companyId], references: [id])
  actorUser   User?    @relation(fields: [actorUserId], references: [id])

  @@index([companyId, createdAt], map: "idx_audit_company_created")
  @@index([companyId], map: "idx_audit_company")
  @@index([actorUserId], map: "idx_audit_actor_user")
  @@map("audit_logs")
}

model SyncQueue {
  id             String          @id @db.VarChar(64)
  companyId      String          @map("company_id") @db.VarChar(64)
  branchId       String          @map("branch_id") @db.VarChar(64)
  userId         String          @map("user_id") @db.VarChar(64)
  clientActionId String          @map("client_action_id") @db.VarChar(120)
  actionType     String          @map("action_type") @db.VarChar(80)
  payloadJson    Json            @map("payload_json")
  status         SyncQueueStatus @default(PENDING)
  errorMessage   String?         @map("error_message") @db.Text
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamp(0)
  company        Company         @relation(fields: [companyId], references: [id])
  user           User            @relation(fields: [userId], references: [id])

  @@unique([companyId, clientActionId], map: "uniq_sync_client_action")
  @@index([companyId], map: "idx_sync_company")
  @@index([userId, status], map: "idx_sync_user_status")
  @@map("sync_queue")
}
