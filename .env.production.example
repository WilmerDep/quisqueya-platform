NODE_ENV=production
PORT=3000
APP_URL=https://api.quisqueyatravel.com.do
CORS_ORIGINS=https://quisqueyatravel.com.do,https://www.quisqueyatravel.com.do,https://app.quisqueyatravel.com.do

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=quisqueya_user
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_DATABASE=quisqueya_core
MYSQL_POOL_LIMIT=10
DATABASE_URL="mysql://quisqueya_user:replace-with-a-strong-database-password@127.0.0.1:3306/quisqueya_core"

JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
